# ---- Server ----
PORT=3000

# ---- Adzuna (https://developer.adzuna.com) ----
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=gb

# ---- Reed (https://www.reed.co.uk/developers) ----
REED_API_KEY=your_reed_api_key

# ---- Jooble (https://jooble.org/api/about) ----
JOOBLE_API_KEY=your_jooble_api_key

# ---- Email (Resend HTTP API — https://resend.com) ----
# Uses a plain HTTPS API call rather than SMTP, so it isn't affected by
# free-tier hosting platforms that block outbound SMTP ports.
RESEND_API_KEY=your_resend_api_key
# The default sender below can only email YOUR OWN Resend account address
# until you verify a real domain at resend.com/domains. To email real
# recipients, verify a domain then change this to an address on it.
RESEND_FROM="Job Broadcaster <onboarding@resend.dev>"

# Name shown in the email body's intro line (e.g. "We from SENDER_NAME have
# brought you...") — this is separate from RESEND_FROM, which controls the
# actual "From:" header address.
SENDER_NAME=Job Broadcaster

# ---- AI-powered extraction for sources without an API (optional) ----
# Used as a fallback when a configured page in services/webExtract/sources.js
# doesn't publish schema.org structured job data. Get a key at
# https://console.anthropic.com — leave blank to skip AI extraction (that
# source will just contribute nothing rather than erroring).
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional — defaults to claude-sonnet-4-6 if not set.
AI_EXTRACT_MODEL=claude-sonnet-4-6

# ---- Prompt-driven AI search (optional) ----
# Powers the "search by prompt" flow: Gemini turns your prompt into search
# queries, Tavily finds candidate pages, Playwright renders them, Gemini
# extracts structured job data. Both keys required for this feature; if
# either is missing, /api/ai-search returns a clear configuration error.
#
# Gemini: https://aistudio.google.com/apikey — IMPORTANT: verify current
# terms before relying on the free tier for anything beyond testing; some
# regions (including the UK/EEA) have had free-tier commercial-use
# restrictions. Check https://ai.google.dev/gemini-api/terms directly.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Tavily: https://tavily.com — free tier is 1,000 search credits/month,
# no credit card required.
TAVILY_API_KEY=your_tavily_api_key

# Resume-based search (/api/ai-search/resumes) uses the same GEMINI_API_KEY
# and TAVILY_API_KEY above — no separate keys needed. Resumes are parsed
# in memory only and never written to disk.
